PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Keep false for the assessment so a live-source failure never silently returns static demo data.
ALLOW_DEMO_FALLBACK=false
# Required for the live semantic planner and compiler.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Required for live compiled business truths and query auditing.
MONGODB_URI=
# Optional Jira Cloud demo connector. Never commit real credentials.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Pipedrive demo connector. Prefer OAuth for a production multi-tenant app.
PIPEDRIVE_API_BASE_URL=https://api.pipedrive.com
PIPEDRIVE_API_TOKEN=
# Offline fallback for the evidence demo; excluded automatically whenever live Drive records exist.
LOCAL_DOCUMENT_ROOT=../demo-data/drive-upload/UPLOAD_THIS_FOLDER
# Live Google Drive evidence connector. Share only the selected root folder with the service-account email.
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Notion internal read-only connection (third live source).
NOTION_API_BASE_URL=https://api.notion.com
NOTION_VERSION=2026-03-11
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# Alternative when Copy data source ID is hidden: use the database ID from its Notion URL.
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_NAME=
